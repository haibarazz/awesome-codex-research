{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/schemas/runtime_response.schema.json",
  "title": "AutoResearch Runtime Response",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/rejection"}
  ],
  "$defs": {
    "allowedAction": {
      "enum": [
        "CREATE_LITERATURE",
        "CREATE_CANDIDATE",
        "CREATE_REPAIR",
        "CREATE_MERGE",
        "SET_FRONTIER",
        "HOLD_NODE",
        "REOPEN_NODE",
        "CLOSE_NODE",
        "PROMOTE_RESEARCH_BASE",
        "ASSIGN_REFERENCE_BASELINE",
        "REGISTER_STAGE_SUMMARY",
        "REGISTER_BASELINE_SEED_EVIDENCE",
        "FINALIZE_RESEARCH",
        "inspect",
        "validate"
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "success": {
      "type": "object",
      "required": ["accepted", "revision", "result", "allowed_next_actions"],
      "properties": {
        "accepted": {"const": true},
        "revision": {"type": "integer", "minimum": 1},
        "result": {"type": "object"},
        "allowed_next_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/allowedAction"}
        }
      },
      "additionalProperties": true
    },
    "rejection": {
      "type": "object",
      "required": [
        "accepted",
        "error_code",
        "violations",
        "allowed_next_actions"
      ],
      "properties": {
        "accepted": {"const": false},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "violations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/violation"}
        },
        "allowed_next_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/allowedAction"}
        }
      },
      "additionalProperties": true
    }
  }
}
